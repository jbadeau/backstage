{
  "name": "@internal/backstage-plugin-hello-backend",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "hello"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --passWithNoTests --coverage",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "lint:fix": "backstage-cli package lint --fix",
    "tsc": "tsc",
    "prettier:check": "prettier --ignore-path ../../.prettierignore --ignore-unknown --check .",
    "prettier:fix": "prettier --ignore-path ../../.prettierignore --ignore-unknown --write ."
  },
  "dependencies": {
    "@backstage/backend-defaults": "^0.18.1",
    "@backstage/backend-plugin-api": "^1.11.0",
    "@backstage/catalog-client": "^1.16.3",
    "@backstage/errors": "^1.3.2",
    "@backstage/plugin-catalog-node": "^2.2.6",
    "@backstage/types": "^1.2.2",
    "express": "^4.14.0",
    "express-promise-router": "^4.1.0",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "^1.11.8",
    "@backstage/cli": "^0.36.7",
    "@types/express": "^4.17.6",
    "@types/supertest": "^2.0.12",
    "prettier": "^2.3.2",
    "supertest": "^6.2.4",
    "typescript": "~5.8.0"
  },
  "files": [
    "dist"
  ]
}
